{
  "name": "Category",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome da categoria"
    },
    "image_url": {
      "type": "string",
      "description": "URL da imagem da categoria"
    },
    "order": {
      "type": "number",
      "description": "Ordem de exibi\u00e7\u00e3o"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Se a categoria est\u00e1 ativa"
    },
    "pdv_only": {
      "type": "boolean",
      "default": false,
      "description": "Categoria exclusiva do PDV (n\u00e3o aparece no totem)"
    }
  },
  "required": [
    "name"
  ]
}