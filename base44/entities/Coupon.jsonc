{
  "name": "Coupon",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "description": "C\u00f3digo do cupom"
    },
    "discount_type": {
      "type": "string",
      "enum": [
        "percentage",
        "fixed"
      ],
      "description": "Tipo de desconto: porcentagem ou valor fixo"
    },
    "discount_value": {
      "type": "number",
      "description": "Valor do desconto (% ou R$)"
    },
    "min_order_value": {
      "type": "number",
      "description": "Valor m\u00ednimo do pedido"
    },
    "max_uses": {
      "type": "number",
      "description": "M\u00e1ximo de usos"
    },
    "used_count": {
      "type": "number",
      "default": 0,
      "description": "Quantidade de vezes usado"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data de expira\u00e7\u00e3o"
    },
    "active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "code",
    "discount_type",
    "discount_value"
  ]
}